# 複製成 .env 後填入。.env 不會進 git。
# 規則 9：金鑰只放在 .env。

# Google Cloud：Places API (New)。請在 Console 設定每日配額上限與帳單警示。
GOOGLE_PLACES_API_KEY=

# Anthropic Claude API（Pro 訂閱不含 API 用量，需另外儲值並設硬上限）
ANTHROPIC_API_KEY=

# Gemini 免費方案（Google AI Studio）。只送公開店家文本（規則 8）
GEMINI_API_KEY=

# Windows 請在系統環境變數或 PowerShell 設：$env:PYTHONUTF8 = "1"
PYTHONUTF8=1
